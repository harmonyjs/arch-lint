{
  "name": "@avavilov/arch-lint",
  "version": "1.0.0",
  "description": "Static architecture linter for TypeScript projects",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "bin": {
    "arch-lint": "./bin/arch-lint.js"
  },
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "bin",
    "docs/rules"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "commander": "14.0.3",
    "jiti": "2.7.0",
    "picocolors": "1.1.1",
    "picomatch": "4.0.4",
    "tinyglobby": "0.2.16",
    "ts-morph": "28.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "25.8.0",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
