{
  "name": "@avavilov/arch-lint",
  "version": "1.0.0",
  "description": "Static architecture linter for TypeScript projects",
  "license": "MIT",
  "author": "Andrey Vavilov <a@vavilov.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonyjs/arch-lint.git"
  },
  "homepage": "https://github.com/harmonyjs/arch-lint#readme",
  "bugs": {
    "url": "https://github.com/harmonyjs/arch-lint/issues"
  },
  "keywords": [
    "architecture",
    "lint",
    "linter",
    "typescript",
    "dependency-graph",
    "layers",
    "monorepo"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "bin": {
    "arch-lint": "./bin/arch-lint.js"
  },
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "bin",
    "docs/rules",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "commander": "15.0.0",
    "jiti": "2.7.0",
    "picocolors": "1.1.1",
    "picomatch": "4.0.7",
    "tinyglobby": "0.2.17",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "11.0.4"
    }
  }
}
